# MySQL / MariaDB connection. Local dev uses XAMPP's MariaDB (root, no password).
# On the VPS, point this at the production database user instead.
DATABASE_URL="mysql://root:@localhost:3306/pro_nutrition"

# Secret used to sign the session cookie (JWT). Change in production.
AUTH_SECRET="pro-nutrition-dev-secret-change-me-in-production-0198"
