# MySQL / MariaDB connection string:
#   mysql://USER:PASSWORD@HOST:3306/DATABASE
# (URL-encode special characters in the password, e.g. @ -> %40)
DATABASE_URL="mysql://pronutrition:CHANGE_ME@localhost:3306/pro_nutrition"

# Secret used to sign the session cookie (JWT). Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Email (password reset links) -------------------------------------------
# Passwords are changed ONLY through a one-time link sent by email, so the server
# needs a mailbox it can send from. Until these are set, "Forgot password?" shows
# a clear "email is not set up" message. Do not commit real values.
#
# Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  (use an App password, not your
#         normal one: Google account > Security > 2-Step Verification > App passwords)
# Zoho:   SMTP_HOST=smtp.zoho.com   SMTP_PORT=587
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Shown as the sender, e.g. "Pro Nutrition <you@gmail.com>"
MAIL_FROM=""
# The public address people use to open the app. Links in emails are built from
# this, so it must be right (https://...). No trailing slash needed.
APP_URL=""
