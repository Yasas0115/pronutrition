// Pro Nutrition — POS data model (MySQL / MariaDB).
// Long free-text / data: URL columns are annotated @db.Text / @db.LongText,
// since a plain MySQL String is VARCHAR(191). MySQL can't default a TEXT
// column, so those are nullable instead of carrying @default.
// Multi-branch: one company (the single Store row) with many Branches. The
// product catalogue is shared company-wide (name, price, image), while stock is
// tracked per branch in BranchStock. Money is stored as whole rupees (Int).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Single company-settings row (name, logo, currency, receipt footer, tax) plus
// the list of enabled modules that gate the sidebar / features.
model Store {
  id             String   @id @default(cuid())
  name           String   @default("Pro Nutrition")
  logoUrl        String?  @db.LongText // small resized data: URL (base64)
  currency       String   @default("Rs")
  phone          String?
  address        String?  @db.Text
  receiptNote    String?  @db.Text
  taxPercent     Int      @default(0) // whole-percent VAT/GST applied at checkout
  // Next invoice number to hand out. Checkout increments it atomically (the
  // row lock serialises concurrent tills), so numbers never collide.
  nextInvoice    Int      @default(1001)
  // Comma-separated module keys that are switched on for this company.
  enabledModules String   @default("pos,products,stock,categories,reports,users,branches,settings")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// A physical branch / outlet. The owner opens and edits these; each branch keeps
// its own stock (BranchStock) and its own sales.
model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String? // short label shown on receipts, e.g. "COL"
  phone     String?
  address   String?  @db.Text
  active    Boolean  @default(true)
  // The fixed amount of cash kept in this branch's till as change (the "float").
  // It is not income or expense, so it never touches profit; every edit is
  // logged in FloatAdjustment and feeds the cash-drawer report.
  floatAmount Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks           BranchStock[]
  sales            Sale[]
  users            User[]
  movements        StockMovement[]
  expenses         Expense[]
  floatAdjustments FloatAdjustment[]

  @@index([active])
}

// Managed pick-list of product categories (add / delete from the Store page).
// Products keep their `category` as a plain string snapshot; this table is the
// authoritative list offered in the category picker and filter chips.
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Configurable payment methods with an auto-applied percentage discount.
// Seeded: CASH 10%, CARD 7%, KOKO 0%.
model PaymentMethod {
  id              String   @id @default(cuid())
  key             String   @unique // CASH | CARD | KOKO | BANK | CREDIT | …
  label           String
  discountPercent Int      @default(0)
  // Walk-in customers may only pay with methods where this is false (Cash,
  // Card). Koko / Bank transfer / Credit need a registered customer.
  requiresCustomer Boolean @default(false)
  // Credit: the customer may pay part now; the rest stays owing on the sale.
  allowsPartial   Boolean  @default(false)
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// A registered customer — a person (RETAIL) or another shop we sell to in bulk
// (SHOP). Needed for Koko, Bank transfer, Credit and every wholesale sale; what
// they still owe is the sum of `balanceDue` over their sales.
model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  address       String?  @db.Text
  type          String   @default("RETAIL") // RETAIL | SHOP
  notes         String?  @db.Text
  active        Boolean  @default(true)
  createdById   String?
  createdByName String? // snapshot of who registered them
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales    Sale[]
  payments SalePayment[]

  @@index([name])
  @@index([phone])
}

// Staff accounts. OWNER sees everything. A STAFF member only sees the modules
// the owner granted them (`modules`), and is optionally pinned to one branch
// (branchId null = all branches, e.g. an accountant who reads company-wide
// reports). `title` is a free label the owner picks — "Accountant", "Cashier",
// "Manager" — purely for display.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         String   @default("STAFF") // OWNER | STAFF
  title        String? // display label: Accountant, Cashier, Manager…
  modules      String   @default("") // comma-separated granted module keys (STAFF only)
  passwordHash String
  branchId     String? // null = all branches; set = pinned to one branch
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales Sale[]

  @@index([branchId])
}

// A product on the shelf — supplements, drinks, accessories, etc. The catalogue
// is company-wide; per-branch stock lives in BranchStock.
model Product {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("Supplements")
  brand     String?
  flavor    String?
  sku       String?
  barcode   String?
  price     Int // selling price, whole rupees
  cost      Int      @default(0) // purchase cost, for margin reports
  imageUrl  String?  @db.LongText // cover thumbnail = first gallery image (kept in sync)
  images    String?  @db.LongText // JSON array of data: URL photos (gallery)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks       BranchStock[]
  saleItems    SaleItem[]
  movements    StockMovement[]
  priceHistory ProductPriceHistory[]

  @@index([category])
  @@index([barcode])
}

// Append-only log of every selling-price / buying-price change on a product.
// `onHandUnits` snapshots the company-wide stock at the moment of the change so
// reports can show how much a price change moved the value of the stock held.
// Product name is snapshotted so the log survives a rename/delete.
model ProductPriceHistory {
  id          String   @id @default(cuid())
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  oldPrice    Int // retail (selling) price before the change
  newPrice    Int // retail (selling) price after the change
  oldCost     Int // buying price before the change
  newCost     Int // buying price after the change
  onHandUnits Int      @default(0) // company-wide units on hand at change time
  source      String   @default("EDIT") // CREATE | EDIT | RESTOCK
  note        String?  @db.Text
  userId      String?
  userName    String? // snapshot of who made the change
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

// Generic "who changed what, when" trail for edits that don't have a ledger of
// their own (products, staff, branches, settings…). Written by lib/audit.ts.
model AuditLog {
  id        String   @id @default(cuid())
  entity    String // PRODUCT | USER | BRANCH | SETTINGS …
  entityId  String?
  action    String // CREATE | UPDATE | DELETE | PRICE_CHANGE …
  summary   String   @db.Text // one human-readable line
  before    String?  @db.LongText // JSON snapshot of the changed fields
  after     String?  @db.LongText // JSON snapshot of the changed fields
  branchId  String?
  userId    String?
  userName  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

// Per-branch stock level for a product. One row per (branch, product).
model BranchStock {
  id         String   @id @default(cuid())
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock      Int      @default(0)
  lowStockAt Int      @default(5)
  updatedAt  DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
}

// One completed sale (a printed receipt / invoice), belonging to a branch.
model Sale {
  id             String   @id @default(cuid())
  number         Int      @unique // human-friendly invoice no, starts at 1001
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchName     String? // snapshot of the branch name at sale time
  subtotal       Int
  discount       Int      @default(0) // total discount = method + manual
  methodDiscount Int      @default(0) // portion from the payment-method %
  manualDiscount Int      @default(0) // portion typed by the cashier
  tax            Int      @default(0)
  total          Int
  paid           Int
  change         Int      @default(0)
  method         String // CASH | CARD | KOKO | BANK | CREDIT
  // Registered customer (null = walk-in). `customerName` stays as a snapshot so
  // old receipts read correctly even if the customer is later renamed/removed.
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName   String?
  saleType       String   @default("RETAIL") // RETAIL | WHOLESALE
  // Still unpaid on this sale (credit). `paid` is cumulative for credit sales:
  // the down payment at checkout plus every later settlement.
  balanceDue     Int      @default(0)
  cashierId      String?
  cashier        User?    @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  cashierName    String?
  createdAt      DateTime @default(now())

  items    SaleItem[]
  payments SalePayment[]

  @@index([createdAt])
  @@index([number])
  @@index([branchId])
  @@index([customerId, balanceDue])
}

// Every payment received against a sale, each with its own date + time: the
// money taken at checkout (kind SALE) and any later credit settlements (kind
// SETTLEMENT). Cash-drawer and collection reports sum this table, so a debt
// paid next week counts on the day the money actually arrived.
model SalePayment {
  id           String    @id @default(cuid())
  saleId       String
  sale         Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  branchId     String? // branch where the money was received
  amount       Int
  method       String // CASH | CARD | BANK | KOKO — how this money came in
  kind         String    @default("SALE") // SALE | SETTLEMENT
  settlementId String? // groups the allocations of one customer payment
  note         String?   @db.Text
  userId       String?
  userName     String? // snapshot of who took the payment
  createdAt    DateTime  @default(now())

  @@index([saleId])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([settlementId])
}

// A line on a sale. Name/price are snapshotted so history stays correct even
// if the product is later renamed, repriced, or deleted.
model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Int // price actually charged per unit (differs from listPrice on a wholesale override)
  qty       Int
  lineTotal Int
  listPrice Int? // shelf (retail) price at the moment of sale
  // Buying price per unit at the moment of sale, for profit reports. Null on
  // sales made before this column existed (reports fall back to current cost).
  unitCost  Int?

  @@index([saleId])
  @@index([productId])
}

// Append-only ledger of every stock change at a branch. One row per movement:
// receiving new stock, a sale, a manual count/correction, or a branch transfer.
// `delta` is signed (positive = added, negative = removed) and `balanceAfter`
// snapshots the resulting on-hand so history reads without recomputation.
// Product name is snapshotted so the log survives a product rename/delete.
model StockMovement {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String // snapshot at movement time
  // RESTOCK | SALE | COUNT | ADJUST | TRANSFER_IN | TRANSFER_OUT | INITIAL
  type        String
  delta       Int // signed change applied to on-hand
  balanceAfter Int // on-hand after this movement
  unitCost    Int? // purchase cost per unit, for RESTOCK
  note        String?  @db.Text // free-text reason / reference
  saleId      String? // links a SALE movement back to its sale
  transferId  String? // pairs the OUT/IN legs of one transfer
  userId      String?
  userName    String? // snapshot of who made the change
  createdAt   DateTime @default(now())

  @@index([branchId, createdAt])
  @@index([productId])
  @@index([transferId])
  @@index([saleId])
}

// Pick-list of expense categories (Rent, Electricity, Transport…), managed from
// the Profit & Expenses page. Expenses keep their category as a plain string
// snapshot, so deleting a category never rewrites history.
model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A shop worker who is paid a salary. Workers are separate from staff logins —
// plenty of shop-floor workers never sign in to the POS.
model Worker {
  id            String   @id @default(cuid())
  name          String
  title         String? // Sales assistant, Cleaner…
  phone         String?
  branchId      String?
  monthlySalary Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments SalaryPayment[]

  @@index([active])
}

// One salary payout. `baseAmount` is the part of the monthly salary it covers,
// `netPaid` (= base + bonus − deduction) is the cash that left the business and
// is what counts as an expense. Saving one also writes the matching Expense row
// (kind SALARY) in the same transaction. Never edited — a mistake is voided.
model SalaryPayment {
  id           String    @id @default(cuid())
  workerId     String?
  worker       Worker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)
  workerName   String // snapshot
  period       String // YYYY-MM the salary is for
  baseAmount   Int
  bonus        Int       @default(0)
  deduction    Int       @default(0)
  netPaid      Int
  paidVia      String    @default("CASH") // CASH | BANK | CARD
  paidAt       DateTime // business date the money was paid
  note         String?   @db.Text
  branchId     String?
  userId       String?
  userName     String? // snapshot of who recorded it
  createdAt    DateTime  @default(now())
  voidedAt     DateTime?
  voidedByName String?
  voidReason   String?   @db.Text

  expense Expense?

  @@index([workerId, period])
  @@index([period])
  @@index([paidAt])
}

// Money that left the business. One ledger for every kind so profit is simply
// the sum by kind: GENERAL (rent, electricity…), SALARY (written by a
// SalaryPayment) and PETTY_CASH (cash taken by a worker — always a plain
// expense, never deducted from salary). Append-only: a mistake is voided with a
// reason (kept, struck through, excluded from reports), never edited or deleted.
model Expense {
  id              String         @id @default(cuid())
  branchId        String? // null = company-wide
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchName      String? // snapshot
  kind            String         @default("GENERAL") // GENERAL | SALARY | PETTY_CASH
  category        String
  amount          Int
  description     String?        @db.Text
  paidVia         String         @default("CASH") // CASH | BANK | CARD
  expenseDate     DateTime // the day it belongs to (Sri Lanka midnight), editable at entry
  workerId        String?
  workerName      String? // who took the cash / who was paid
  salaryPaymentId String?        @unique
  salaryPayment   SalaryPayment? @relation(fields: [salaryPaymentId], references: [id], onDelete: SetNull)
  userId          String?
  userName        String? // snapshot of who recorded it
  createdAt       DateTime       @default(now()) // the real moment it was entered
  voidedAt        DateTime?
  voidedByName    String?
  voidReason      String?        @db.Text

  @@index([expenseDate])
  @@index([kind, expenseDate])
  @@index([branchId, expenseDate])
}

// History of the till float. Every change records what it was, what it became
// and why, with who/when — so a drawer report can use the float that applied on
// any given day.
model FloatAdjustment {
  id         String   @id @default(cuid())
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchName String // snapshot
  oldAmount  Int
  newAmount  Int
  delta      Int
  reason     String   @db.Text
  userId     String?
  userName   String? // snapshot of who changed it
  createdAt  DateTime @default(now())

  @@index([branchId, createdAt])
}
